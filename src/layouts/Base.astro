---
import '../styles/site.css';
import { canonicalUrl, SITE_DESCRIPTION, SITE_NAME, SITE_TAGLINE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Path to this page's markdown mirror, e.g. "/demos/resend-cube.md". */
  mdPath?: string;
  /** JSON-LD graph nodes to emit for this page. */
  jsonLd?: unknown[];
}

const { title, description, mdPath, jsonLd = [] } = Astro.props as Props;
const base = import.meta.env.BASE_URL; // respects astro.config base
const pageTitle = title ? `${title} — ${SITE_NAME}` : SITE_TAGLINE;
const pageDescription = description || SITE_DESCRIPTION;
const canonical = canonicalUrl(Astro.url.pathname);
const CC_URL = 'https://claude.com/claude-code';
const REPO_URL = 'https://github.com/statico/cool-web-fx';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    {/* Markdown mirror of this page, for agents that prefer plain text. The
        same file is served for `Accept: text/markdown` — see vercel.json. */}
    {mdPath && (
      <link rel="alternate" type="text/markdown" href={canonicalUrl(mdPath)} title={`${pageTitle} (Markdown)`} />
    )}

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    {jsonLd.length > 0 && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd })}
      />
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <div class="brand">
          <span class="mark">◆</span>
          <h1><a href={base}>Cool web interaction effects that Ian likes</a></h1>
        </div>
        <a class="cc-badge" href={CC_URL} target="_blank" rel="noopener">
          <span class="dot"></span> Generated with Claude Code
        </a>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>
          Generated with <a href={CC_URL} target="_blank" rel="noopener">Claude Code</a>.
          Inspired by <a href="https://reactbits.dev" target="_blank" rel="noopener">reactbits.dev</a>.
          Recreations for educational use; original code and techniques are
          copyright their respective creators.
        </span>
        <span>
          <a href={`${base}glossary`}>glossary</a> ·
          <a href={`${base}AGENTS.md`}>AGENTS.md</a> ·
          <a href={`${base}skill.md`}>skill.md</a> ·
          <a href={`${base}llms.txt`}>llms.txt</a> ·
          <a href={REPO_URL} target="_blank" rel="noopener">source</a>
        </span>
      </div>
    </footer>
  </body>
</html>
