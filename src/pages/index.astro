---
import Base from '../layouts/Base.astro';
import { canonicalUrl, newestModified, SITE_DESCRIPTION, SITE_NAME, SITE_TAGLINE } from '../lib/site';

const base = import.meta.env.BASE_URL;

// Each demo is described by src/demos/<slug>.json and runs from
// public/effects/<slug>.html. Glob the metadata and sort by `order`.
const metaModules = import.meta.glob('../demos/*.json', { eager: true });
const demos = Object.values(metaModules)
  .map((m) => (m as any).default)
  .sort((a, b) => (a.order ?? 999) - (b.order ?? 999));

const dateModified = newestModified(demos.map((d) => `src/demos/${d.slug}.json`));

const jsonLd = [
  {
    '@type': 'WebSite',
    '@id': `${canonicalUrl('/')}#website`,
    name: SITE_NAME,
    alternateName: SITE_TAGLINE,
    url: canonicalUrl('/'),
    description: SITE_DESCRIPTION,
    inLanguage: 'en',
  },
  {
    '@type': 'CollectionPage',
    '@id': `${canonicalUrl('/')}#page`,
    name: SITE_TAGLINE,
    url: canonicalUrl('/'),
    description: SITE_DESCRIPTION,
    isPartOf: { '@id': `${canonicalUrl('/')}#website` },
    inLanguage: 'en',
    dateModified,
    hasPart: demos.map((d) => ({
      '@type': 'SoftwareSourceCode',
      name: d.title,
      url: canonicalUrl(`/demos/${d.slug}`),
      abstract: d.blurb,
      programmingLanguage: 'HTML',
    })),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl('/')}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: canonicalUrl('/') },
    ],
  },
];
---
<Base mdPath="/index.md" jsonLd={jsonLd} wide>
  <div class="home">
    <aside class="home-side">
      <p class="lede">
        Web interaction effects I think are cool, each recreated from scratch as
        one copy-pasteable HTML file.
      </p>
      <p class="count">{demos.length} effects. Each one credits the site where I first saw it.</p>

      <details>
        <summary>How to use an effect</summary>
        <p>
          Open an effect, hit <strong>Copy code</strong>, and paste the whole file
          into your project. It is a complete HTML document with the CSS and
          JavaScript inline: no bundler, no package install, no API key.
        </p>
        <p>
          Only <code>resend-cube</code> loads an external library (Three.js, pinned
          via an import map). Every other effect makes no network calls.
        </p>
      </details>

      <details>
        <summary>For coding agents</summary>
        <p>
          Start with <a href={`${base}skill.md`}>skill.md</a> or <a href={`${base}AGENTS.md`}>AGENTS.md</a>. They explain how to grab an
          effect and what attribution to keep.
        </p>
        <p>
          Indexes: <a href={`${base}llms.txt`}>llms.txt</a>, <a href={`${base}sitemap.md`}>sitemap.md</a>, <a href={`${base}sitemap.xml`}>sitemap.xml</a>. Every page has a Markdown
          mirror at the same path with a <code>.md</code> suffix.
        </p>
      </details>

      <details>
        <summary>About this gallery</summary>
        <p>
          The full code is printed on each demo page, so humans and LLMs can read
          it without running anything. Terms are defined in the <a href={`${base}glossary`}>glossary</a>. Inspired by <a href="https://reactbits.dev" target="_blank" rel="noopener">reactbits.dev</a>.
        </p>
      </details>
    </aside>

    <section class="gallery" aria-label="Effects">
      {demos.map((d) => (
        <a class="card" href={`${base}demos/${d.slug}`}>
          <img
            class="thumb"
            src={`${base}thumbs/${d.slug}.png`}
            alt=""
            loading="lazy"
            width="1200"
            height="750"
            onerror="this.classList.add('thumb-fallback');this.removeAttribute('src');"
          />
          <span class="title">{d.title}</span>
          <span class="src">{d.sourceName}</span>
          <span class="blurb">{d.blurb}</span>
        </a>
      ))}
    </section>
  </div>
</Base>
