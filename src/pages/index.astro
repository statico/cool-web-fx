---
import Base from '../layouts/Base.astro';
import { canonicalUrl, newestModified, SITE_DESCRIPTION, SITE_NAME, SITE_TAGLINE } from '../lib/site';

const base = import.meta.env.BASE_URL;

// Each demo is described by src/demos/<slug>.json and runs from
// public/effects/<slug>.html. Glob the metadata and sort by `order`.
const metaModules = import.meta.glob('../demos/*.json', { eager: true });
const demos = Object.values(metaModules)
  .map((m) => (m as any).default)
  .sort((a, b) => (a.order ?? 999) - (b.order ?? 999));

const dateModified = newestModified(demos.map((d) => `src/demos/${d.slug}.json`));

const jsonLd = [
  {
    '@type': 'WebSite',
    '@id': `${canonicalUrl('/')}#website`,
    name: SITE_NAME,
    alternateName: SITE_TAGLINE,
    url: canonicalUrl('/'),
    description: SITE_DESCRIPTION,
    inLanguage: 'en',
  },
  {
    '@type': 'CollectionPage',
    '@id': `${canonicalUrl('/')}#page`,
    name: SITE_TAGLINE,
    url: canonicalUrl('/'),
    description: SITE_DESCRIPTION,
    isPartOf: { '@id': `${canonicalUrl('/')}#website` },
    inLanguage: 'en',
    dateModified,
    hasPart: demos.map((d) => ({
      '@type': 'SoftwareSourceCode',
      name: d.title,
      url: canonicalUrl(`/demos/${d.slug}`),
      abstract: d.blurb,
      programmingLanguage: 'HTML',
    })),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl('/')}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: canonicalUrl('/') },
    ],
  },
];
---
<Base mdPath="/index.md" jsonLd={jsonLd}>
  <section class="intro">
    <p class="lede">
      A growing gallery of web interaction effects I think are cool — each one
      recreated from scratch as copy-pasteable HTML/CSS/JS.
    </p>
    <p>
      Every demo is a single self-contained file you can lift straight into your
      own page. The full code is embedded in each page (no build step, no API) so
      it's easy for humans and LLMs to read. Each effect credits where I first saw
      it. Inspired by <a href="https://reactbits.dev" target="_blank" rel="noopener">reactbits.dev</a>.
    </p>
  </section>

  <section class="intro">
    <h2>How to use an effect</h2>
    <p>
      Open any effect below, hit <strong>Copy code</strong>, and paste the whole
      file into your own project — it is a complete HTML document with the CSS and
      JavaScript inline. Nothing here needs a bundler, a package install, or an API
      key. Only <code>resend-cube</code> loads an external library (Three.js, pinned
      via an import map); every other effect makes no network calls at all.
    </p>
  </section>

  <section class="intro">
    <h2>For coding agents</h2>
    <p>
      If you are an LLM or coding agent, start with
      <a href={`${base}skill.md`}>skill.md</a> or
      <a href={`${base}AGENTS.md`}>AGENTS.md</a> — they explain how to grab an
      effect and what attribution to keep. Machine-readable indexes live at
      <a href={`${base}llms.txt`}>llms.txt</a>,
      <a href={`${base}sitemap.md`}>sitemap.md</a> and
      <a href={`${base}sitemap.xml`}>sitemap.xml</a>, and every page has a Markdown
      mirror at the same path with a <code>.md</code> suffix. Unfamiliar terms are
      defined in the <a href={`${base}glossary`}>glossary</a>.
    </p>
  </section>

  <h2 class="gallery-heading">All effects</h2>
  <div class="gallery">
    {demos.map((d) => (
      <a class="card" href={`${base}demos/${d.slug}`}>
        <img
          class="thumb"
          src={`${base}thumbs/${d.slug}.png`}
          alt={`${d.title} preview`}
          loading="lazy"
          width="320"
          height="200"
          onerror="this.classList.add('thumb-fallback');this.removeAttribute('src');this.alt='preview';"
        />
        <div class="body">
          <div class="title">{d.title}</div>
          <div class="src">{d.sourceName}</div>
          <div class="blurb">{d.blurb}</div>
        </div>
      </a>
    ))}
  </div>
</Base>
