---
import Base from '../layouts/Base.astro';
import { canonicalUrl, lastModified } from '../lib/site';
// Shared with scripts/generate-agent-files.mjs, which renders /glossary.md from
// the same list so the page and its Markdown mirror can't drift.
import terms from '../data/glossary.json';

const base = import.meta.env.BASE_URL;

const DESCRIPTION =
  'Definitions of the rendering and animation terms used across the cool-web-fx effect writeups — canvas, shader, SDF, import map, and more.';


const jsonLd = [
  {
    '@type': 'DefinedTermSet',
    '@id': `${canonicalUrl('/glossary')}#glossary`,
    name: 'cool-web-fx glossary',
    url: canonicalUrl('/glossary'),
    description: DESCRIPTION,
    inLanguage: 'en',
    dateModified: lastModified('src/pages/glossary.astro'),
    isPartOf: { '@id': `${canonicalUrl('/')}#website` },
    hasDefinedTerm: terms.map((t) => ({
      '@type': 'DefinedTerm',
      name: t.term.replace(/<[^>]+>/g, ''),
      description: t.def.replace(/<[^>]+>/g, ''),
    })),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl('/glossary')}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: canonicalUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Glossary', item: canonicalUrl('/glossary') },
    ],
  },
];
---
<Base title="Glossary" description={DESCRIPTION} mdPath="/glossary.md" jsonLd={jsonLd}>
  <div class="demo-main">
    <div class="crumb"><a href={base}>← all effects</a></div>

    <section class="intro">
      <h2>Glossary</h2>
      <p class="lede">
        Terms used in the effect writeups, defined once so you don't have to
        infer them from context.
      </p>
    </section>

    <section class="block">
      <h3>Terminology</h3>
      <dl class="glossary">
        {terms.map((t) => (
          <>
            <dt set:html={t.term} />
            <dd set:html={t.def} />
          </>
        ))}
      </dl>
    </section>
  </div>
</Base>
